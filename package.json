  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:server": "tsx watch src/back-end/index.ts",
    "prepare": "husky",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
