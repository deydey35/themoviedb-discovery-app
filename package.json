  },
  "allowScripts": {
    "typescript@7.0.2": true,
    "@types/node@26.5.0": true,
    "@types/express@5.0.6": true,
    "tsx@4.23.13": true,
    "@commitlint/cli@21.2.2": true,
    "@commitlint/config-conventional@21.2.2": true,
    "husky@9.1.7": true,
    "oxlint@1.83.0": true,
    "@vitejs/plugin-react@6.1.1": true,
    "react@19.3.0": true,
    "react-dom@19.3.0": true,
    "@types/react@19.3.0": true,
    "@types/react-dom@19.3.0": true,
    "vite@8.3.0": true,
    "oxfmt@0.69.0": true,
    "lint-staged@17.5.1": true
